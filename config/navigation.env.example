# Public example only. Copy this file to config/navigation.env on each robot
# and replace every placeholder before enabling chassis output.
# config/navigation.env is intentionally excluded from public source control.

# LimX signaling endpoint reachable from the NX.
WEBSOCKET_URL="ws://192.0.2.2:5000"

# Hardware identity assigned to the target robot. Required format:
# WF_<MODEL>_<ID>
WEBSOCKET_ROBOT_ACCID="WF_MODEL_000"

# NX address used only by laptop route diagnostics and deployment commands.
NX_IP="192.0.2.10"

# Optional map handoff destinations used by prepare_pct_map.sh.
NX_MAP_STORAGE_ROOT="/path/to/nx/map-storage"
NX_NAVIGATION_ROOT="/path/to/navigation"

# ROS 2 DDS settings shared by the NX and visualization laptop.
# 26 is the documented default used by this stack's launch scripts, not a site
# identifier. Change it to isolate a workspace on a shared network.
ROS_DOMAIN_ID="26"
ROS_LOCALHOST_ONLY="0"
RMW_IMPLEMENTATION="rmw_fastrtps_cpp"

# Optional: only needed when the two GPL clones are not placed in the documented
# sibling directories next to tron2-navigation-ros2.
# FAST_LIO_GPL_ROOT="/absolute/path/to/tron2-navigation-fastlio-gpl"
# PCT_GPL_ROOT="/absolute/path/to/tron2-navigation-pct-gpl"

# Optional robot-specific navigation speed. The script fallback is 0.60 m/s
# and the accepted maximum is 0.80 m/s.
# NAV_SPEED="0.60"

# Normal navigation keeps local obstacle-cloud avoidance enabled. Do not set
# this false in a site configuration for ordinary operation. The supervised
# path-only test must use `navi.sh nav --no-obstacle-avoidance --speed MPS`;
# it starts paused and permits no more than 0.60 m/s.
# ENABLE_LOCAL_OBSTACLE_AVOIDANCE="true"

# The validated stair centerline is a path-only test mode and requires
# ENABLE_LOCAL_OBSTACLE_AVOIDANCE="false". Use it only through:
# navi.sh nav --no-obstacle-avoidance --stair-centerline --speed MPS
# ENABLE_PCT_STAIR_CENTERLINE="false"

# One mapping session writes two coordinate-identical PCD files: the full
# range map is used by ICP localization, while the near-field map is used to
# build a clean, high-resolution PCT tomogram for stairs.
MAPPING_LOCALIZATION_MAX_DISTANCE="100"
MAPPING_REGISTRATION_MAX_DISTANCE="15"
MAPPING_PCT_MAX_DISTANCE="15"
MAPPING_PCT_RESOLUTION="0.1"
